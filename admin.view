<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Portal - Banarasi Sanskriti</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css?v=21">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="icon" type="image/png" href="/assets/images/logo.png">
  <style>
    :root {
      --admin-bg: #0d0a08;
      --admin-card-bg: rgba(22, 17, 13, 0.92);
      --admin-border: rgba(201, 168, 76, 0.22);
      --admin-border-hover: rgba(201, 168, 76, 0.55);
      --admin-gold: #c9a84c;
      --admin-gold-light: #e5cf87;
    }

    body {
      background-color: var(--admin-bg);
      color: #f5f0e8;
      font-family: 'Outfit', sans-serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    /* Top Admin Header */
    .admin-navbar {
      background: rgba(13, 10, 8, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--admin-border);
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 16px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .admin-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #fff;
    }
    .admin-brand img {
      width: 38px;
      height: 38px;
      object-fit: contain;
      border-radius: 50%;
      border: 1px solid var(--admin-gold);
    }
    .admin-brand h1 {
      font-family: 'Cinzel', serif;
      font-size: 1.25rem;
      color: var(--admin-gold);
      letter-spacing: 1px;
      margin: 0;
    }
    .admin-badge {
      background: rgba(201, 168, 76, 0.15);
      border: 1px solid var(--admin-gold);
      color: var(--admin-gold-light);
      font-size: 0.75rem;
      padding: 3px 8px;
      border-radius: 20px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      font-weight: 600;
    }
    .admin-header-actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .admin-nav-link {
      color: rgba(245, 240, 232, 0.8);
      text-decoration: none;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 6px;
      border: 1px solid transparent;
      transition: all 0.3s;
    }
    .admin-nav-link:hover {
      color: var(--admin-gold);
      border-color: var(--admin-border);
      background: rgba(201, 168, 76, 0.08);
    }

    /* Container */
    .admin-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 30px 24px 80px;
    }

    /* KPI Stats Bar */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }
    .stat-card {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 10px;
      padding: 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      transition: transform 0.3s, border-color 0.3s;
    }
    .stat-card:hover {
      transform: translateY(-3px);
      border-color: var(--admin-border-hover);
    }
    .stat-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: rgba(201, 168, 76, 0.12);
      border: 1px solid rgba(201, 168, 76, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: var(--admin-gold);
    }
    .stat-meta h3 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: rgba(245, 240, 232, 0.6);
      margin: 0 0 4px 0;
      font-weight: 500;
    }
    .stat-meta .stat-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: #fff;
      font-family: 'Cinzel', serif;
      margin: 0;
    }

    /* Tabs Bar */
    .admin-tabs {
      display: flex;
      gap: 12px;
      border-bottom: 1px solid var(--admin-border);
      margin-bottom: 28px;
    }
    .admin-tab-btn {
      background: transparent;
      border: none;
      color: rgba(245, 240, 232, 0.6);
      font-size: 1.05rem;
      font-weight: 500;
      padding: 12px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 2px solid transparent;
      transition: all 0.3s;
      font-family: 'Outfit', sans-serif;
    }
    .admin-tab-btn:hover {
      color: #fff;
    }
    .admin-tab-btn.active {
      color: var(--admin-gold);
      border-bottom-color: var(--admin-gold);
      font-weight: 600;
    }
    .tab-badge {
      background: var(--admin-gold);
      color: #0d0a08;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 12px;
    }

    /* Main Grid Layout */
    .admin-layout {
      display: grid;
      grid-template-columns: 420px 1fr;
      gap: 32px;
      align-items: start;
    }

    /* Form Card */
    .admin-form-card {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 28px;
      position: sticky;
      top: 90px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.4);
    }
    .admin-form-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 22px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--admin-border);
    }
    .admin-form-header h2 {
      font-family: 'Cinzel', serif;
      color: var(--admin-gold);
      font-size: 1.3rem;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block;
      margin-bottom: 7px;
      font-size: 0.85rem;
      font-weight: 500;
      color: rgba(245, 240, 232, 0.9);
      letter-spacing: 0.3px;
    }
    .form-group input, 
    .form-group textarea,
    .form-group select {
      width: 100%;
      padding: 11px 14px;
      background: rgba(13, 10, 8, 0.7);
      border: 1px solid rgba(201, 168, 76, 0.3);
      color: #fff;
      border-radius: 6px;
      font-family: 'Outfit', sans-serif;
      font-size: 0.92rem;
      box-sizing: border-box;
      transition: all 0.25s ease;
    }
    .form-group input:focus, 
    .form-group textarea:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--admin-gold);
      box-shadow: 0 0 0 2px rgba(201, 168, 76, 0.2);
    }
    .form-group select option {
      background: #16120e;
      color: #fff;
    }

    /* Live Image Preview Area */
    .file-upload-box {
      border: 2px dashed rgba(201, 168, 76, 0.35);
      border-radius: 8px;
      padding: 18px;
      text-align: center;
      background: rgba(13, 10, 8, 0.4);
      cursor: pointer;
      transition: all 0.3s;
      position: relative;
    }
    .file-upload-box:hover {
      border-color: var(--admin-gold);
      background: rgba(201, 168, 76, 0.05);
    }
    .file-upload-box input[type="file"] {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }
    .upload-icon {
      font-size: 1.8rem;
      color: var(--admin-gold);
      margin-bottom: 6px;
    }
    .image-preview-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }
    .preview-thumb {
      width: 54px;
      height: 54px;
      border-radius: 6px;
      object-fit: cover;
      border: 1px solid var(--admin-gold);
    }

    /* Action Buttons */
    .admin-btn-primary {
      background: linear-gradient(135deg, #c9a84c, #b08e38);
      color: #0d0a08;
      border: none;
      padding: 12px 20px;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.92rem;
      letter-spacing: 0.5px;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
    }
    .admin-btn-primary:hover {
      background: linear-gradient(135deg, #dfbe61, #c9a84c);
      box-shadow: 0 4px 15px rgba(201, 168, 76, 0.35);
      transform: translateY(-1px);
    }
    .admin-btn-secondary {
      background: transparent;
      border: 1px solid var(--admin-border);
      color: rgba(245, 240, 232, 0.85);
      padding: 10px 18px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.88rem;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .admin-btn-secondary:hover {
      border-color: var(--admin-gold);
      color: var(--admin-gold);
    }

    /* Inventory & Filter Bar */
    .inventory-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }
    .search-filter-box {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      flex-grow: 1;
    }
    .search-input-wrap {
      position: relative;
      flex-grow: 1;
      min-width: 220px;
    }
    .search-input-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(201, 168, 76, 0.6);
      font-size: 0.9rem;
    }
    .search-input-wrap input {
      width: 100%;
      padding: 10px 14px 10px 36px;
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      color: #fff;
      border-radius: 6px;
      font-family: 'Outfit', sans-serif;
      box-sizing: border-box;
    }
    .filter-select {
      padding: 10px 14px;
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      color: #fff;
      border-radius: 6px;
      font-family: 'Outfit', sans-serif;
    }

    /* Product Table / Cards */
    .product-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .product-row {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 10px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.25);
      transition: all 0.3s;
    }
    .product-row:hover {
      border-color: var(--admin-border-hover);
      box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    }
    .product-main {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-grow: 1;
    }
    .product-thumb-container {
      position: relative;
      width: 70px;
      height: 90px;
      flex-shrink: 0;
    }
    .product-thumb-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--admin-border);
    }
    .thumb-badge {
      position: absolute;
      bottom: 4px;
      right: 4px;
      background: rgba(13, 10, 8, 0.85);
      color: var(--admin-gold);
      font-size: 0.65rem;
      padding: 2px 4px;
      border-radius: 4px;
      border: 1px solid var(--admin-gold);
      font-weight: 600;
    }
    .product-details h4 {
      font-family: 'Cinzel', serif;
      font-size: 1.15rem;
      color: #fff;
      margin: 0 0 6px 0;
      letter-spacing: 0.5px;
    }
    .product-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }
    .tag-pill {
      font-size: 0.75rem;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(201, 168, 76, 0.1);
      border: 1px solid rgba(201, 168, 76, 0.25);
      color: var(--admin-gold-light);
    }
    .product-price-tag {
      color: var(--admin-gold);
      font-weight: 700;
      font-size: 1.1rem;
      font-family: 'Cinzel', serif;
    }
    .product-desc-snippet {
      color: rgba(245, 240, 232, 0.65);
      font-size: 0.85rem;
      margin: 4px 0 0 0;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .row-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .action-btn {
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.25s;
    }
    .btn-edit {
      background: transparent;
      border: 1px solid var(--admin-gold);
      color: var(--admin-gold);
    }
    .btn-edit:hover {
      background: var(--admin-gold);
      color: #0d0a08;
    }
    .btn-delete {
      background: transparent;
      border: 1px solid rgba(255, 68, 68, 0.4);
      color: #ff5555;
    }
    .btn-delete:hover {
      background: #ff4444;
      color: #fff;
      border-color: #ff4444;
    }

    /* Enquiries Tab */
    .enquiry-card {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 10px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      position: relative;
      transition: border-color 0.3s;
    }
    .enquiry-card:hover {
      border-color: var(--admin-border-hover);
    }
    .enquiry-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid rgba(201, 168, 76, 0.15);
      padding-bottom: 14px;
      margin-bottom: 14px;
    }
    .enquiry-user h4 {
      font-family: 'Cinzel', serif;
      color: #fff;
      font-size: 1.2rem;
      margin: 0 0 6px 0;
    }
    .enquiry-contact-links {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      font-size: 0.88rem;
      color: rgba(245, 240, 232, 0.75);
    }
    .enquiry-contact-links a {
      color: var(--admin-gold);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: color 0.2s;
    }
    .enquiry-contact-links a:hover {
      color: #fff;
      text-decoration: underline;
    }
    .enquiry-message-box {
      background: rgba(13, 10, 8, 0.6);
      border-left: 3px solid var(--admin-gold);
      padding: 14px 18px;
      border-radius: 0 6px 6px 0;
      color: rgba(245, 240, 232, 0.9);
      font-size: 0.92rem;
      line-height: 1.65;
      white-space: pre-line;
      margin-bottom: 16px;
    }
    .enquiry-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .enquiry-time {
      font-size: 0.8rem;
      color: rgba(245, 240, 232, 0.45);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Toast Notifications */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .toast {
      background: #16120e;
      border: 1px solid var(--admin-gold);
      color: #fff;
      padding: 14px 20px;
      border-radius: 8px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.6);
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.9rem;
      animation: slideIn 0.3s ease forwards;
    }
    .toast.success i { color: #4ade80; }
    .toast.error i { color: #f87171; }
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    @media (max-width: 1024px) {
      .admin-layout {
        grid-template-columns: 1fr;
      }
      .admin-form-card {
        position: static;
      }
    }
    @media (max-width: 640px) {
      .admin-navbar { padding: 12px 16px; }
      .admin-container { padding: 20px 12px; }
      .product-row { flex-direction: column; align-items: flex-start; }
      .row-actions { width: 100%; justify-content: flex-end; }
    }
  </style>
</head>
<body>

  <!-- Top Admin Bar -->
  <header class="admin-navbar">
    <a href="/" class="admin-brand">
      <img src="/assets/images/logo.png" alt="Banarasi Sanskriti">
      <div>
        <h1>Banarasi Sanskriti</h1>
      </div>
      <span class="admin-badge"><i class="fas fa-shield-alt"></i> Management Suite</span>
    </a>
    <div class="admin-header-actions">
      <a href="/" target="_blank" class="admin-nav-link"><i class="fas fa-external-link-alt"></i> View Store</a>
      <a href="/collection" target="_blank" class="admin-nav-link"><i class="fas fa-gem"></i> Catalog</a>
    </div>
  </header>

  <div class="admin-container">
    <!-- Key Performance Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-boxes"></i></div>
        <div class="stat-meta">
          <h3>Active Inventory</h3>
          <div class="stat-value" id="statTotalProducts">-</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-envelope-open-text"></i></div>
        <div class="stat-meta">
          <h3>Customer Enquiries</h3>
          <div class="stat-value" id="statTotalEnquiries">-</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-coins"></i></div>
        <div class="stat-meta">
          <h3>Default Currency</h3>
          <div class="stat-value" style="font-size: 1.4rem; color: var(--admin-gold);">AED (Dirham)</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
        <div class="stat-meta">
          <h3>Primary Silks</h3>
          <div class="stat-value" style="font-size: 1.2rem;">Banarasi Silk</div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="admin-tabs">
      <button class="admin-tab-btn active" id="tabInventoryBtn">
        <i class="fas fa-tshirt"></i> Products Inventory
        <span class="tab-badge" id="badgeInventoryCount">0</span>
      </button>
      <button class="admin-tab-btn" id="tabEnquiriesBtn">
        <i class="fas fa-comments"></i> Customer Inquiries
        <span class="tab-badge" id="badgeEnquiryCount">0</span>
      </button>
    </div>

    <!-- TAB 1: INVENTORY MANAGEMENT -->
    <div id="inventorySection" class="tab-content">
      <div class="admin-layout">
        
        <!-- Product Creation / Editing Form -->
        <div class="admin-form-card">
          <div class="admin-form-header">
            <h2 id="formTitle"><i class="fas fa-plus-circle"></i> Add New Product</h2>
            <button type="button" class="admin-btn-secondary" id="cancelBtn" style="display: none; padding: 5px 10px; font-size: 0.8rem;">
              <i class="fas fa-times"></i> Cancel Edit
            </button>
          </div>

          <form id="uploadForm">
            <div class="form-group">
              <label><i class="fas fa-tag"></i> Product Title</label>
              <input type="text" id="title" required placeholder="e.g. Royal Emerald Abaya">
            </div>

            <div class="form-group">
              <label><i class="fas fa-align-left"></i> Description</label>
              <textarea id="desc" rows="3" required placeholder="e.g. Handcrafted pure silk with intricate zari work"></textarea>
            </div>

            <div class="form-group">
              <label><i class="fas fa-money-bill-wave"></i> Price in AED</label>
              <input type="text" id="price" required placeholder="e.g. 750 or AED 750">
              <small id="pricePreview" style="color: var(--admin-gold); display: block; margin-top: 4px; font-size: 0.8rem; font-weight: 500;"></small>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="form-group">
                <label>Collection Type</label>
                <select id="collectionType" required>
                  <option value="Luxury Abaya">Luxury Abaya</option>
                  <option value="Banarasi Silk">Banarasi Silk</option>
                  <option value="Organza (Kora)">Organza (Kora)</option>
                  <option value="Georgette">Georgette</option>
                  <option value="Shattir">Shattir</option>
                </select>
              </div>

              <div class="form-group">
                <label>Color Family</label>
                <select id="colorFamily" required>
                  <option value="Crimson Red">Crimson Red</option>
                  <option value="Midnight Blue">Midnight Blue</option>
                  <option value="Emerald Green">Emerald Green</option>
                  <option value="Golden Glow">Golden Glow</option>
                  <option value="Ivory">Ivory</option>
                  <option value="Black">Black</option>
                </select>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="form-group">
                <label>Price Range Tier</label>
                <select id="priceRange" required>
                  <option value="Under AED 1,000">Under AED 1,000</option>
                  <option value="AED 1,000 - AED 2,500">AED 1,000 - AED 2,500</option>
                  <option value="AED 2,500+">AED 2,500+</option>
                </select>
              </div>

              <div class="form-group">
                <label>Weaving Pattern</label>
                <select id="pattern" required>
                  <option value="Floral Jaal">Floral Jaal</option>
                  <option value="Geometric Buti">Geometric Buti</option>
                  <option value="Shikargah">Shikargah</option>
                  <option value="Contemporary">Contemporary</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label><i class="fas fa-images"></i> Product Photos (Up to 5)</label>
              <div class="file-upload-box">
                <i class="fas fa-cloud-upload-alt upload-icon"></i>
                <div style="font-size: 0.88rem; color: #fff; font-weight: 500;">Click to select or drag images</div>
                <div style="font-size: 0.75rem; color: rgba(245,240,232,0.5); margin-top: 2px;">JPEG, PNG, WebP (Max 10MB per file)</div>
                <input type="file" id="images" accept="image/*" multiple>
              </div>
              <div class="image-preview-strip" id="imagePreviewStrip"></div>
            </div>

            <button type="submit" class="admin-btn-primary" id="submitBtn">
              <i class="fas fa-upload"></i> Save & Publish Product
            </button>
          </form>
        </div>

        <!-- Inventory List View -->
        <div>
          <div class="inventory-header">
            <div class="search-filter-box">
              <div class="search-input-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="inventorySearch" placeholder="Search by title, color, style...">
              </div>
              <select id="filterCollectionSelect" class="filter-select">
                <option value="ALL">All Collections</option>
                <option value="Luxury Abaya">Luxury Abaya</option>
                <option value="Banarasi Silk">Banarasi Silk</option>
                <option value="Organza (Kora)">Organza (Kora)</option>
                <option value="Georgette">Georgette</option>
                <option value="Shattir">Shattir</option>
              </select>
            </div>
            <button type="button" class="admin-btn-secondary" id="refreshInventoryBtn">
              <i class="fas fa-sync-alt"></i> Refresh
            </button>
          </div>

          <div class="product-list" id="productList">
            <!-- Rendered dynamically -->
          </div>
        </div>

      </div>
    </div>

    <!-- TAB 2: CUSTOMER ENQUIRIES -->
    <div id="enquiriesSection" class="tab-content" style="display: none;">
      <div class="inventory-header">
        <div class="search-input-wrap" style="max-width: 400px;">
          <i class="fas fa-search"></i>
          <input type="text" id="enquirySearch" placeholder="Search customer name, email, message...">
        </div>
        <button type="button" class="admin-btn-secondary" id="refreshEnquiriesBtn">
          <i class="fas fa-sync-alt"></i> Refresh Enquiries
        </button>
      </div>

      <div id="enquiryList" style="display: flex; flex-direction: column; gap: 16px; margin-top: 10px;">
        <!-- Rendered dynamically -->
      </div>
    </div>

  </div>

  <!-- Toast Notification System -->
  <div class="toast-container" id="toastContainer"></div>

  <script src="/admin.js?v=21"></script>
</body>
</html>
